@using JobApplicationTracker.Configuration
@using Microsoft.Extensions.Options
@inject IOptionsSnapshot<ApplicationInfoOptions> ApplicationInfo
@inject IOptionsSnapshot<ThemeOptions> Theme

@{
    var configuredThemePreference = Theme.Value.DefaultMode switch
    {
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        ThemeMode.System => "system",
        _ => "system"
    };

    var themeSelectionEnabled = Theme.Value.AllowUserSelection
        ? "true"
        : "false";

    var fallbackBootstrapTheme = Theme.Value.DefaultMode == ThemeMode.Dark
        ? "dark"
        : "light";

    var configuredPalette = Theme.Value.DefaultPalette switch
    {
        ThemePalette.Ocean => "ocean",
        ThemePalette.Fall => "fall",
        ThemePalette.Coffee => "coffee",
        ThemePalette.Sakura => "sakura",
        ThemePalette.Forest => "forest",
        _ => "ocean"
    };

    var paletteSelectionEnabled = Theme.Value.AllowPaletteSelection
        ? "true"
        : "false";
}

<!DOCTYPE html>
<html lang="en"
    data-theme-default="@configuredThemePreference"
    data-theme-selection-enabled="@themeSelectionEnabled"
    data-bs-theme="@fallbackBootstrapTheme"
    data-palette-default="@configuredPalette"
    data-palette-selection-enabled="@paletteSelectionEnabled"
    data-theme-palette="@configuredPalette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobApplicationTracker</title>
    <script type="importmap"></script>
    <script src="~/js/theme-initializer.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme-palettes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobApplicationTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">JobApplicationTracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                asp-controller="JobApplications"
                                asp-action="Index">
                                    Applications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav ms-auto">
                        @if (Theme.Value.AllowUserSelection ||
                            Theme.Value.AllowPaletteSelection)
                        {
                            <li class="nav-item me-sm-3 my-2 my-sm-0">
                                <fieldset class="border-0 p-0 m-0 d-flex
                                    flex-column flex-sm-row gap-2">
                                    <legend class="visually-hidden">
                                        Appearance
                                    </legend>

                                    @if (Theme.Value.AllowUserSelection)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <label for="theme-preference"
                                                class="form-label small mb-0">
                                                Mode
                                            </label>
                                            <select id="theme-preference"
                                                class="form-select form-select-sm w-auto">
                                                <option value="system"
                                                    selected="@(configuredThemePreference == "system")">
                                                    System
                                                </option>
                                                <option value="light"
                                                    selected="@(configuredThemePreference == "light")">
                                                    Light
                                                </option>
                                                <option value="dark"
                                                    selected="@(configuredThemePreference == "dark")">
                                                    Dark
                                                </option>
                                            </select>
                                        </div>
                                    }

                                    @if (Theme.Value.AllowPaletteSelection)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <label for="palette-preference"
                                                class="form-label small mb-0">
                                                Theme
                                            </label>
                                            <select id="palette-preference"
                                                class="form-select form-select-sm w-auto">
                                                <option value="ocean"
                                                    selected="@(configuredPalette == "ocean")">
                                                    Ocean
                                                </option>
                                                <option value="fall"
                                                    selected="@(configuredPalette == "fall")">
                                                    Fall
                                                </option>
                                                <option value="coffee"
                                                    selected="@(configuredPalette == "coffee")">
                                                    Coffee
                                                </option>
                                                <option value="sakura"
                                                    selected="@(configuredPalette == "sakura")">
                                                    Sakura
                                                </option>
                                                <option value="forest"
                                                    selected="@(configuredPalette == "forest")">
                                                    Forest
                                                </option>
                                            </select>
                                        </div>
                                    }
                                </fieldset>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="navbar-text">
                                    Signed in as @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                    asp-action="Logout"
                                    method="post">
                                    <button type="submit"
                                            class="btn btn-outline-secondary">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-controller="Account"
                                asp-action="Login"
                                class="nav-link">
                                    Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year -
            @ApplicationInfo.Value.Name - @ApplicationInfo.Value.Applicator -
            <a asp-area=""
            asp-controller="Home"
            asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
