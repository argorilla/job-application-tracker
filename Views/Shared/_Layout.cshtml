@using JobApplicationTracker.Configuration
@using Microsoft.Extensions.Options
@inject IOptionsSnapshot<ApplicationInfoOptions> ApplicationInfo
@inject IOptionsSnapshot<ThemeOptions> Theme

@{
    var currentController = ViewContext.RouteData.Values["controller"]
        ?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]
        ?.ToString();

    var isDashboardActive = string.Equals(
        currentController,
        "Home",
        StringComparison.OrdinalIgnoreCase) &&
        string.Equals(
            currentAction,
            "Index",
            StringComparison.OrdinalIgnoreCase);

    var isApplicationsActive = string.Equals(
        currentController,
        "JobApplications",
        StringComparison.OrdinalIgnoreCase);

    var isLoginPage = string.Equals(
        currentController,
        "Account",
        StringComparison.OrdinalIgnoreCase) &&
        string.Equals(
            currentAction,
            "Login",
            StringComparison.OrdinalIgnoreCase);

    var configuredThemePreference = Theme.Value.DefaultMode switch
    {
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        ThemeMode.System => "system",
        _ => "system"
    };

    var themeSelectionEnabled = Theme.Value.AllowUserSelection
        ? "true"
        : "false";

    var fallbackBootstrapTheme = Theme.Value.DefaultMode == ThemeMode.Dark
        ? "dark"
        : "light";

    var configuredPalette = Theme.Value.DefaultPalette switch
    {
        ThemePalette.Ocean => "ocean",
        ThemePalette.Fall => "fall",
        ThemePalette.Coffee => "coffee",
        ThemePalette.Sakura => "sakura",
        ThemePalette.Forest => "forest",
        _ => "ocean"
    };

    var paletteSelectionEnabled = Theme.Value.AllowPaletteSelection
        ? "true"
        : "false";
}

<!DOCTYPE html>
<html lang="en"
    data-theme-default="@configuredThemePreference"
    data-theme-selection-enabled="@themeSelectionEnabled"
    data-bs-theme="@fallbackBootstrapTheme"
    data-palette-default="@configuredPalette"
    data-palette-selection-enabled="@paletteSelectionEnabled"
    data-theme-palette="@configuredPalette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobApplicationTracker</title>
    <script type="importmap"></script>
    <script src="~/js/theme-initializer.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme-palettes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobApplicationTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Job Application Tracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent"
                    class="navbar-collapse collapse d-lg-flex
                           justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link @(isDashboardActive ? "active" : null)"
                                    aria-current="@(isDashboardActive ? "page" : null)"
                                    asp-area=""
                                    asp-controller="Home"
                                    asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isApplicationsActive ? "active" : null)"
                                    aria-current="@(isApplicationsActive ? "page" : null)"
                                    asp-controller="JobApplications"
                                    asp-action="Index">
                                    Applications
                                </a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav ms-auto">
                        @if (Theme.Value.AllowUserSelection ||
                            Theme.Value.AllowPaletteSelection)
                        {
                            <li class="nav-item dropdown appearance-dropdown
                                       me-lg-3 my-2 my-lg-0">
                                <button id="appearanceDropdown"
                                    class="btn btn-outline-secondary dropdown-toggle
                                           appearance-trigger"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false">
                                    Appearance
                                </button>

                                <div class="dropdown-menu dropdown-menu-end
                                            appearance-panel"
                                    aria-labelledby="appearanceDropdown">
                                    @if (Theme.Value.AllowUserSelection)
                                    {
                                        <fieldset class="appearance-fieldset">
                                            <legend class="appearance-legend">
                                                Mode
                                            </legend>

                                            <div class="appearance-mode-grid">
                                              <div class="appearance-mode-option">
                                                <input id="appearance-mode-system"
                                                    class="visually-hidden appearance-radio
                                                           appearance-mode-radio"
                                                    type="radio"
                                                    name="appearance-mode"
                                                    value="system"
                                                    checked="@(configuredThemePreference == "system")" />
                                                <label class="appearance-mode-label"
                                                    for="appearance-mode-system">
                                                    System
                                                </label>
                                              </div>
                                              <div class="appearance-mode-option">
                                                <input id="appearance-mode-light"
                                                    class="visually-hidden appearance-radio
                                                           appearance-mode-radio"
                                                    type="radio"
                                                    name="appearance-mode"
                                                    value="light"
                                                    checked="@(configuredThemePreference == "light")" />
                                                <label class="appearance-mode-label"
                                                    for="appearance-mode-light">
                                                    Light
                                                </label>
                                              </div>
                                              <div class="appearance-mode-option">
                                                <input id="appearance-mode-dark"
                                                    class="visually-hidden appearance-radio
                                                           appearance-mode-radio"
                                                    type="radio"
                                                    name="appearance-mode"
                                                    value="dark"
                                                    checked="@(configuredThemePreference == "dark")" />
                                                <label class="appearance-mode-label"
                                                    for="appearance-mode-dark">
                                                    Dark
                                                </label>
                                              </div>
                                            </div>
                                        </fieldset>
                                    }

                                    @if (Theme.Value.AllowPaletteSelection)
                                    {
                                        <fieldset class="appearance-fieldset
                                            appearance-palette-fieldset
                                            @(Theme.Value.AllowUserSelection ? "appearance-fieldset-separated" : null)">
                                            <legend class="appearance-legend">
                                                Palette
                                            </legend>

                                            <div class="appearance-palette-grid">
                                              <div class="appearance-palette-option">
                                                <input id="appearance-palette-ocean"
                                                    class="visually-hidden appearance-radio
                                                           appearance-palette-radio"
                                                    type="radio"
                                                    name="appearance-palette"
                                                    value="ocean"
                                                    checked="@(configuredPalette == "ocean")" />
                                                <label class="appearance-palette-card"
                                                    for="appearance-palette-ocean">
                                                    <span class="appearance-palette-swatch appearance-palette-swatch-ocean"
                                                        data-palette="ocean"
                                                        aria-hidden="true"></span>
                                                    Ocean
                                                </label>
                                              </div>
                                              <div class="appearance-palette-option">
                                                <input id="appearance-palette-fall"
                                                    class="visually-hidden appearance-radio
                                                           appearance-palette-radio"
                                                    type="radio"
                                                    name="appearance-palette"
                                                    value="fall"
                                                    checked="@(configuredPalette == "fall")" />
                                                <label class="appearance-palette-card"
                                                    for="appearance-palette-fall">
                                                    <span class="appearance-palette-swatch appearance-palette-swatch-fall"
                                                        data-palette="fall"
                                                        aria-hidden="true"></span>
                                                    Fall
                                                </label>
                                              </div>
                                              <div class="appearance-palette-option">
                                                <input id="appearance-palette-coffee"
                                                    class="visually-hidden appearance-radio
                                                           appearance-palette-radio"
                                                    type="radio"
                                                    name="appearance-palette"
                                                    value="coffee"
                                                    checked="@(configuredPalette == "coffee")" />
                                                <label class="appearance-palette-card"
                                                    for="appearance-palette-coffee">
                                                    <span class="appearance-palette-swatch appearance-palette-swatch-coffee"
                                                        data-palette="coffee"
                                                        aria-hidden="true"></span>
                                                    Coffee
                                                </label>
                                              </div>
                                              <div class="appearance-palette-option">
                                                <input id="appearance-palette-sakura"
                                                    class="visually-hidden appearance-radio
                                                           appearance-palette-radio"
                                                    type="radio"
                                                    name="appearance-palette"
                                                    value="sakura"
                                                    checked="@(configuredPalette == "sakura")" />
                                                <label class="appearance-palette-card"
                                                    for="appearance-palette-sakura">
                                                    <span class="appearance-palette-swatch appearance-palette-swatch-sakura"
                                                        data-palette="sakura"
                                                        aria-hidden="true"></span>
                                                    Sakura
                                                </label>
                                              </div>
                                              <div class="appearance-palette-option">
                                                <input id="appearance-palette-forest"
                                                    class="visually-hidden appearance-radio
                                                           appearance-palette-radio"
                                                    type="radio"
                                                    name="appearance-palette"
                                                    value="forest"
                                                    checked="@(configuredPalette == "forest")" />
                                                <label class="appearance-palette-card"
                                                    for="appearance-palette-forest">
                                                    <span class="appearance-palette-swatch appearance-palette-swatch-forest"
                                                        data-palette="forest"
                                                        aria-hidden="true"></span>
                                                    Forest
                                                </label>
                                              </div>
                                            </div>
                                        </fieldset>
                                    }

                                    <p class="appearance-helper-text">
                                        Preferences are stored in this browser.
                                    </p>
                                </div>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-lg-3">
                                <span class="navbar-text navbar-username"
                                    title="@User.Identity.Name">
                                    Signed in as @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                    asp-action="Logout"
                                    method="post">
                                    <button type="submit"
                                            class="btn btn-outline-secondary">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else if (!isLoginPage)
                        {
                            <li class="nav-item">
                                <a asp-controller="Account"
                                asp-action="Login"
                                class="nav-link">
                                    Sign in
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year -
            @ApplicationInfo.Value.Name - @ApplicationInfo.Value.Applicator -
            <a asp-area=""
            asp-controller="Home"
            asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
